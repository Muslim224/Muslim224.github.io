<!-- 🎬 صندوق عرض الفيلم بدون إعلانات منبثقة -->
<div style="width:100%; max-width:950px; margin:30px auto; background:#111; border-radius:12px; overflow:hidden; box-shadow:0 0 30px rgba(255,0,0,0.4);">
  
  <div style="background:#000; color:#fff; padding:12px; font-size:18px; font-weight:bold; text-align:center; letter-spacing:1px;">
    🎬 شاهد الآن
  </div>

  <!-- ==== صندوق عرض المشاهدة ==== -->
  <div class="movie-box" id="movieBox">
    <iframe id="movieFrame"
      src="https://topcinema.fan/beast-games-%d8%a7%d9%84%d9%85%d9%88%d8%b3%d9%85-%d8%a7%d9%84%d8%ab%d8%a7%d9%86%d9%8a-%d8%a7%d9%84%d8%ad%d9%84%d9%82%d8%a9-1-%d9%85%d8%aa%d8%b1%d8%ac%d9%85%d8%a9/watch/"
      frameborder="0"
      allowfullscreen
      sandbox="allow-scripts allow-same-origin allow-presentation">
    </iframe>
  </div>

</div>

<style>
/* الصندوق العام */
.movie-box{
  position:relative;
  width:100%;
  max-width:920px;
  height:770px; /* زيادة 50px إضافية (من 720px -> 770px) */
  margin:0 auto;
  overflow:hidden;
  border-radius:10px;
  background:#000;
  box-shadow:0 12px 36px rgba(0,0,0,0.6);
}

/* iframe مكبر ومرفوع */
#movieFrame{
  width:100%;
  height:1200px;
  border:none;
  transform:scale(1.15) translateY(-320px);
  transform-origin:top;
  display:block;
}
</style>

<script>
(function(){
  var frame = document.getElementById('movieFrame');

  // تثبيت التحجيم
  frame.style.transform = 'scale(1.15) translateY(-320px)';

  // 🛡️ منع النوافذ المنبثقة
  try{ window._originalOpen = window.open; }catch(e){}
  window.open = function(){ return null; };

  document.addEventListener('click', function(e){
    var t = e.target;
    if(t && t.tagName === 'A' && t.target === '_blank'){
      e.preventDefault();
      e.stopPropagation();
      return false;
    }
  }, true);
})();
</script>
